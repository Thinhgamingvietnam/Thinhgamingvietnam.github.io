/* Keep the original translator, then apply the larger v22 dictionary. */
const oldTr = (typeof tr==='function') ? tr : (x=>x);
const enText=(value)=>{
  if(value==null)return value;
  let s=String(value);
  if(window.__swEn){const _r=window.__swEn(s);if(_r!==null&&_r!==undefined)return _r}
  try{s=oldTr(s)}catch(_){}
  const exact=s.trim();
  if(EN[exact]!==undefined){
    const a=s.indexOf(exact);
    return s.slice(0,a)+EN[exact]+s.slice(a+exact.length);
  }
  const keys=Object.keys(EN).sort((a,b)=>b.length-a.length);
  for(const k of keys) if(s.includes(k)) s=s.split(k).join(EN[k]);
  return s;
};

function translateNode(n){
  if(!n)return;
  if(n.nodeType===3){
    const v=enText(n.nodeValue);
    if(v!==n.nodeValue)n.nodeValue=v;
    return;
  }
  if(n.nodeType!==1)return;
  for(const a of ['title','aria-label','placeholder']){
    if(n.hasAttribute(a)){
      const v=enText(n.getAttribute(a));
      if(v!==n.getAttribute(a))n.setAttribute(a,v);
    }
  }
  if(n.tagName==='OPTION'){
    const v=enText(n.textContent);
    if(v!==n.textContent)n.textContent=v;
  }
  n.childNodes&&n.childNodes.forEach(translateNode);
}

let enObserver=null;
function applyEnglish(){
  try{
    if(typeof LANG!=='undefined')LANG='en';
    document.documentElement.lang='en';
    document.title='Stick Warriors — BO3';
    translateNode(document.body);
    if(enObserver)enObserver.disconnect();
    enObserver=new MutationObserver(ms=>{
      for(const m of ms){
        if(m.type==='characterData')translateNode(m.target);
        else m.addedNodes.forEach(translateNode);
      }
    });
    enObserver.observe(document.body,{childList:true,subtree:true,characterData:true});
  }catch(e){}
}

