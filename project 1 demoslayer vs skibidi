using UnityEngine;

public class TitanCombat : MonoBehaviour
{
    [Header("3 Speaker Transforms")]
    public Transform centerSpeaker;
    public Transform leftSpeaker;
    public Transform rightSpeaker;

    [Header("2 Side Screens")]
    public Transform leftScreen;
    public Transform rightScreen;

    [Header("Damage")]
    public float punchDamage = 150f;
    public float soundDamage = 250f;
    public float plasmaDamage = 350f;
    public float ultimateDamage = 1000f;

    [Header("Attack Ranges")]
    public float punchRange = 4f;
    public float soundRange = 10f;
    public float plasmaRange = 30f;
    public float ultimateRange = 20f;

    [Header("Cooldowns")]
    public float soundCooldown = 3f;
    public float plasmaCooldown = 2f;
    public float ultimateCooldown = 12f;

    [Header("Optional Projectile Prefabs")]
    public GameObject soundWavePrefab;
    public GameObject plasmaPrefab;
    public GameObject ultimateEffectPrefab;

    private float nextSoundTime;
    private float nextPlasmaTime;
    private float nextUltimateTime;
    private TitanTVMan titan;

    private void Awake()
    {
        titan = GetComponent<TitanTVMan>();
    }

    private void Update()
    {
        if (titan != null && titan.IsDead) return;

        if (Input.GetKeyDown(KeyCode.J))
            PunchAttack();

        if (Input.GetKeyDown(KeyCode.K))
            SoundWaveAttack();

        if (Input.GetKeyDown(KeyCode.L))
            PlasmaAttack();

        if (Input.GetKeyDown(KeyCode.R))
            UltimateAttack();
    }

    // J: Dam can chien
    public void PunchAttack()
    {
        DealAreaDamage(
            transform.position + transform.forward * 2f,
            punchRange,
            punchDamage
        );
    }

    // K: Ca 3 loa phat song am
    public void SoundWaveAttack()
    {
        if (Time.time < nextSoundTime) return;
        nextSoundTime = Time.time + soundCooldown;

        SpawnEffect(centerSpeaker, soundWavePrefab);
        SpawnEffect(leftSpeaker, soundWavePrefab);
        SpawnEffect(rightSpeaker, soundWavePrefab);

        DealAreaDamage(
            transform.position + transform.forward * 5f,
            soundRange,
            soundDamage
        );
    }

    // L: Hai man hinh ban plasma
    public void PlasmaAttack()
    {
        if (Time.time < nextPlasmaTime) return;
        nextPlasmaTime = Time.time + plasmaCooldown;

        SpawnEffect(leftScreen, plasmaPrefab);
        SpawnEffect(rightScreen, plasmaPrefab);

        // Ban theo huong nhin cua Titan
        DealAreaDamage(
            transform.position + transform.forward * 12f,
            plasmaRange,
            plasmaDamage
        );
    }

    // R: Tuyet ky dien rong
    public void UltimateAttack()
    {
        if (Time.time < nextUltimateTime) return;
        nextUltimateTime = Time.time + ultimateCooldown;

        if (ultimateEffectPrefab != null)
        {
            Instantiate(
                ultimateEffectPrefab,
                transform.position + transform.forward * 5f,
                Quaternion.identity
            );
        }

        DealAreaDamage(
            transform.position + transform.forward * 5f,
            ultimateRange,
            ultimateDamage
        );
    }

    private void SpawnEffect(
        Transform origin,
        GameObject prefab)
    {
        if (origin == null || prefab == null) return;

        Instantiate(prefab, origin.position, origin.rotation);
    }

    private void DealAreaDamage(
        Vector3 center,
        float range,
        float damage)
    {
        Collider[] hits = Physics.OverlapSphere(center, range);

        foreach (Collider hit in hits)
        {
            EnemyHealth enemy =
                hit.GetComponentInParent<EnemyHealth>();

            if (enemy != null)
                enemy.TakeDamage(damage);
        }
    }

    private void OnDrawGizmosSelected()
    {
        Gizmos.color = Color.magenta;
        Gizmos.DrawWireSphere(
            transform.position + transform.forward * 5f,
            soundRange
        );

        Gizmos.color = Color.cyan;
        Gizmos.DrawWireSphere(
            transform.position + transform.forward * 12f,
            plasmaRange
        );
    }
}

