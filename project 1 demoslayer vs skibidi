using UnityEngine;
using System.Collections;

public class BlackSmokePortal : MonoBehaviour
{
    [Header("Portal Settings")]
    public float teleportDistance = 15f;
    public float cooldown = 5f;
    public float disappearDuration = 0.35f;

    [Header("Black Smoke Particle")]
    public ParticleSystem smokeEffect;

    private float nextTeleportTime;
    private bool isTeleporting;
    private CharacterController controller;

    private void Awake()
    {
        controller = GetComponent<CharacterController>();
    }

    private void Update()
    {
        if (Input.GetKeyDown(KeyCode.F))
            TryTeleport();
    }

    public void TryTeleport()
    {
        if (isTeleporting || Time.time < nextTeleportTime)
            return;

        StartCoroutine(TeleportRoutine());
    }

    private IEnumerator TeleportRoutine()
    {
        isTeleporting = true;
        nextTeleportTime = Time.time + cooldown;

        Vector3 destination =
            transform.position
            + transform.forward * teleportDistance;

        // Giu do cao hien tai
        destination.y = transform.position.y;

        // Khong cho Titan dich chuyen vao vat can
        Vector3 direction = (destination - transform.position).normalized;

        if (Physics.Raycast(
            transform.position + Vector3.up,
            direction,
            out RaycastHit hit,
            teleportDistance))
        {
            destination = hit.point - direction * 1.5f;
            destination.y = transform.position.y;
        }

        if (smokeEffect != null)
        {
            smokeEffect.transform.position = transform.position;
            smokeEffect.Play();
        }

        // An mo hinh trong luc dich chuyen
        Renderer[] renderers =
            GetComponentsInChildren<Renderer>();

        foreach (Renderer renderer in renderers)
            renderer.enabled = false;

        yield return new WaitForSeconds(disappearDuration);

        if (controller != null)
            controller.enabled = false;

        transform.position = destination;

        if (controller != null)
            controller.enabled = true;

        foreach (Renderer renderer in renderers)
            renderer.enabled = true;

        if (smokeEffect != null)
        {
            smokeEffect.transform.position = destination;
            smokeEffect.Play();
        }

        isTeleporting = false;
    }
}

